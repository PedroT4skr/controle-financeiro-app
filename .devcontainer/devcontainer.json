{
  "name": "Flutter Controle Financeiro",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/anthropics/devcontainer-features/flutter:1": {
      "version": "latest",
      "channel": "stable"
    }
  },
  "postCreateCommand": "flutter pub get",
  "forwardPorts": [8080],
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "nash.awesome-flutter-snippets"
      ],
      "settings": {
        "dart.flutterSdkPath": "/home/codespace/flutter",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "Dart-Code.dart-code"
      }
    }
  },
  "remoteUser": "codespace"
}
