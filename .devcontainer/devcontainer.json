{
    "name": "Flutter Failsafe",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "forwardPorts": [8080],
    "postCreateCommand": "git clone https://github.com/flutter/flutter.git -b stable ~/.flutter && ~/.flutter/bin/flutter config --enable-web",
    "customizations": {
        "vscode": {
            "settings": {
                "dart.flutterSdkPath": "~/.flutter"
            }
        }
    }
}